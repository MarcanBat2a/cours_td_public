# Qui stocke quoi. C'est LE fichier que vous modifiez au fil des chapitres.
# Après modification : docker compose up -d web
# Chaque branche de TD livre ce fichier réglé sur l'état où le chapitre
# précédent a laissé le site (voir etapes.json).
#
#   CATALOGUE   sql | mongo
#   TOP         sql | mongo | redis
#   HISTORIQUE  sql | mongo | cassandra
#   RECO        sql | mongo | neo4j
#   CACHE       aucun | redis

CATALOGUE=mongo
TOP=redis
HISTORIQUE=mongo
RECO=mongo
CACHE=redis

# Où sont les bases. Les noms sont ceux des services de docker-compose.yml.
PG_DSN=postgresql://ondine:ondine@pg:5432/ondine
MONGO_URL=mongodb://mongo:27017
# Replica set du chapitre 1      :  mongodb://mongo1,mongo2,mongo3/?replicaSet=rs-td
# Chapitre 5 (cluster shardé)     :  mongodb://mongos:27017
REDIS_URL=redis://redis:6379
NEO4J_URL=bolt://neo4j:7687
CASSANDRA_HOSTS=cassandra
# Chapitre 4, anneau : CASSANDRA_HOSTS=cass1,cass2,cass3 et CASSANDRA_CL=QUORUM
CASSANDRA_CL=ONE

CACHE_TTL_S=60
# Chapitre 3, mission 5 : le journal de Redis (yes pour survivre à une panne).
REDIS_AOF=no
RECO_FENETRE_JOURS=30

# Le port du site sur votre machine (si 8000 est déjà pris).
ONDINE_PORT=8000
